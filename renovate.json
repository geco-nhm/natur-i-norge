{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "scratch/**",
    "archive/**"
  ],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Ignore Flutter-owned Gradle plugins (resolved via Flutter SDK includeBuild)",
      "matchPackageNames": [
        "dev.flutter.flutter-plugin-loader",
        "dev.flutter.flutter-gradle-plugin"
      ],
      "enabled": false
    },
    {
      "description": "Block major Gradle / AGP / Kotlin updates tightly coupled to Flutter toolchain",
      "matchPackageNames": [
        "gradle",
        "com.android.application",
        "org.jetbrains.kotlin.android"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Block major Google Services Gradle plugin updates (review manually)",
      "matchPackageNames": [
        "com.google.gms.google-services"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group non-major Google Services plugin updates",
      "matchPackageNames": [
        "com.google.gms.google-services"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Android Google services"
    },
    {
      "description": "Isolate Dart/Flutter SDK constraint updates for manual review",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "dart",
        "flutter"
      ],
      "groupName": "Dart/Flutter SDK",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Residual: group remaining pub minor/patch updates to limit CI noise (specific groups below override)",
      "matchManagers": [
        "pub"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Flutter pub (minor/patch)"
    },
    {
      "description": "Group Firebase + google_sign_in auth stack (including majors)",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "firebase_core",
        "firebase_auth",
        "firebase_storage",
        "cloud_firestore",
        "google_sign_in",
        "/^firebase_/"
      ],
      "groupName": "Firebase dependencies"
    },
    {
      "description": "Group Riverpod packages (including majors)",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "flutter_riverpod",
        "riverpod"
      ],
      "groupName": "Riverpod"
    },
    {
      "description": "Group Drift + codegen stack (including majors). After merging Drift bumps, run: dart run build_runner build --delete-conflicting-outputs",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "drift",
        "drift_dev",
        "sqlite3",
        "sqlite3_flutter_libs",
        "build_runner",
        "json_annotation",
        "json_serializable"
      ],
      "groupName": "Drift / codegen"
    },
    {
      "description": "Group flutter_map stack (including majors)",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "flutter_map",
        "flutter_map_cancellable_tile_provider",
        "latlong2"
      ],
      "groupName": "flutter_map"
    }
  ]
}
