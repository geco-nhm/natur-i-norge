# Fastfile
# Generated by mobile-ops

require "shellwords"
require "securerandom"

default_platform(:android)

ROOT_DIR = File.expand_path("..", __dir__)

# -----------------------------------------------------------------------------
# Shared Helper Methods
# -----------------------------------------------------------------------------

def flutter(*cmd)
  command_str = cmd.join(" ")
  sh("cd #{ROOT_DIR.shellescape} && flutter #{command_str}")
end

def build_args(options)
  args = []
  build_number = options[:build_number] || ENV["BUILD_NUMBER"]
  build_name = options[:build_name] || ENV["BUILD_NAME"]

  args << "--build-number=#{build_number}" if build_number && !build_number.to_s.empty?
  args << "--build-name=#{build_name}" if build_name && !build_name.to_s.empty?
  args
end

def ensure_flutter_dependencies
  UI.message("📦 Resolving Flutter dependencies...")
  flutter("pub get")
end

def setup_asc_api_key
  secret_key_file = File.join(ROOT_DIR, ".secrets/AuthKey.p8")
  local_key_file = Dir[File.join(ROOT_DIR, "secrets/AuthKey*.p8")].first
  key_filepath = ENV["APP_STORE_KEY_FILE"] || (File.exist?(secret_key_file) ? secret_key_file : local_key_file)

  key_id = ENV["APP_STORE_KEY_ID"] || ENV["KEY_ID"]
  if !key_id && key_filepath && key_filepath =~ /AuthKey_([A-Z0-9]+)\.p8/
    key_id = $1
  end

  issuer_id = ENV["APP_STORE_ISSUER_ID"] || ENV["ISSUER_ID"]

  unless key_id && issuer_id && key_filepath && File.exist?(key_filepath)
    UI.user_error!("App Store Connect API key credentials missing! (key_id: #{key_id.inspect}, issuer_id: #{issuer_id.inspect}, key_filepath: #{key_filepath.inspect})")
  end

  UI.message("🔑 Loading App Store Connect API Key (ID: #{key_id})...")
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath
  )
end

def google_play_key_path
  secret_play_file = File.join(ROOT_DIR, ".secrets/google-play-key.json")
  key_path = ENV["SUPPLY_JSON_KEY"] || (File.exist?(secret_play_file) ? secret_play_file : nil)
  unless key_path && File.exist?(key_path)
    UI.user_error!("Google Play service account key JSON missing! Checked SUPPLY_JSON_KEY and #{secret_play_file}")
  end
  key_path
end

# -----------------------------------------------------------------------------
# Android Platform
# -----------------------------------------------------------------------------

platform :android do
  desc "Run Flutter tests"
  lane :test do
    ensure_flutter_dependencies
    flutter("test")
  end

  desc "Build Android release APK"
  lane :build_apk do |options|
    ensure_flutter_dependencies
    args = build_args(options)
    flutter("build apk --release #{args.join(' ')}".strip)
  end

  desc "Build Android release App Bundle (AAB)"
  lane :build_bundle do |options|
    ensure_flutter_dependencies
    args = build_args(options)
    flutter("build appbundle --release #{args.join(' ')}".strip)
  end

  desc "Build Android release artifacts (both AAB and APK)"
  lane :build do |options|
    build_bundle(options)
    build_apk(options)
  end

  desc "Build and distribute Android beta to Google Play Internal track"
  lane :beta do |options|
    build(options)

    key_path = google_play_key_path
    track = options[:track] || "internal"
    release_status = options[:release_status] || ENV["PLAY_RELEASE_STATUS"] || "draft"
    has_metadata = Dir.exist?(File.join(ROOT_DIR, "fastlane/metadata/android"))
    aab_path = Dir[File.join(ROOT_DIR, "build/app/outputs/bundle/**/*.aab")].first
    UI.user_error!("No AAB artifact found in build/app/outputs/bundle/ to upload to Google Play!") unless aab_path && File.exist?(aab_path)

    UI.message("🚀 Uploading AAB and Git metadata to Google Play track: #{track} (status: #{release_status})...")
    upload_to_play_store(
      track: track,
      json_key: key_path,
      aab: aab_path,
      release_status: release_status,
      skip_upload_metadata: !has_metadata,
      skip_upload_images: !has_metadata,
      skip_upload_screenshots: !has_metadata,
      skip_upload_changelogs: false
    )
  end

  desc "Build and deploy Android release to Google Play Production track"
  lane :release do |options|
    build(options)

    key_path = google_play_key_path
    track = options[:track] || "production"
    release_status = options[:release_status] || ENV["PLAY_RELEASE_STATUS"] || "draft"
    has_metadata = Dir.exist?(File.join(ROOT_DIR, "fastlane/metadata/android"))
    aab_path = Dir[File.join(ROOT_DIR, "build/app/outputs/bundle/**/*.aab")].first
    UI.user_error!("No AAB artifact found in build/app/outputs/bundle/ to upload to Google Play!") unless aab_path && File.exist?(aab_path)

    UI.message("🚀 Uploading AAB and Git metadata to Google Play track: #{track} (status: #{release_status})...")
    upload_to_play_store(
      track: track,
      json_key: key_path,
      aab: aab_path,
      release_status: release_status,
      skip_upload_metadata: !has_metadata,
      skip_upload_images: !has_metadata,
      skip_upload_screenshots: !has_metadata,
      skip_upload_changelogs: false
    )
  end

  desc "Upload store metadata, changelogs, and images to Google Play without rebuilding"
  lane :metadata do |options|
    key_path = google_play_key_path
    UI.message("📝 Uploading metadata and store listing to Google Play...")
    upload_to_play_store(
      json_key: key_path,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false
    )
  end
end

# -----------------------------------------------------------------------------
# iOS Platform
# -----------------------------------------------------------------------------

platform :ios do
  desc "Register App Identifier on Apple Developer Portal and create App in App Store Connect"
  lane :create_app do
    api_key = setup_asc_api_key
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    produce(
      app_identifier: app_id,
      app_name: "naturinorge_guide",
      language: "en-US",
      sku: "naturinorge_guide".downcase.gsub(/[^a-z0-9]/, "")
    )
  end

  desc "Run Flutter tests"
  lane :test do
    ensure_flutter_dependencies
    flutter("test")
  end

  desc "Compile Flutter iOS without code signing (archive preparation / validation)"
  lane :build_archive do |options|
    ensure_flutter_dependencies
    args = build_args(options)
    UI.message("🏗 Compiling Flutter iOS bundle without codesigning...")
    flutter("build ios --release --no-codesign #{args.join(' ')}".strip)
  end

  desc "Build iOS IPA"
  lane :build do |options|
    ensure_flutter_dependencies
    args = build_args(options)
    export_method = options[:export_method] || ENV["IOS_EXPORT_METHOD"] || "app-store"

    api_key = setup_asc_api_key
    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id) || ENV["APPLE_TEAM_ID"]
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    p12_path = File.join(ROOT_DIR, ".secrets/distribution.p12")
    p12_password = ENV["P12_PASSWORD"] || ENV["CERTIFICATE_PASSWORD"]
    UI.user_error!("Distribution certificate (.p12) missing at #{p12_path}!") unless File.exist?(p12_path)
    UI.user_error!("P12_PASSWORD environment variable missing!") unless p12_password && !p12_password.empty?

    keychain_name = "ci_signing"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = SecureRandom.hex(16)
    original_keychains = sh("security list-keychains -d user").shellsplit rescue []

    delete_keychain(name: keychain_name) if File.exist?(keychain_path)

    begin
      UI.message("🔐 Creating ephemeral build keychain (#{keychain_name})...")
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        add_to_search_list: false,
        unlock: true,
        timeout: 3600
      )

      UI.message("🔓 Unlocking build keychain and isolating search list...")
      unlock_keychain(
        path: keychain_path,
        password: keychain_password,
        add_to_search_list: :replace,
        set_default: true
      )

      UI.message("📥 Importing Distribution .p12 into ephemeral keychain...")
      import_certificate(
        certificate_path: p12_path,
        certificate_password: p12_password,
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )

      UI.message("📱 Ensuring App Store Provisioning Profile is installed and up-to-date...")
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: app_id,
        team_id: team_id,
        force: true
      )
      profile_name = Actions.lane_context[SharedValues::SIGH_NAME] || "#{app_id} AppStore"
      UI.message("  Using Provisioning Profile: #{profile_name}")

      UI.message("🏗 Compiling Flutter iOS bundle...")
      flutter("build ios --release --no-codesign #{args.join(' ')}".strip)

      UI.message("📦 Archiving and packaging iOS IPA (export_method: #{export_method})...")
      gym_params = {
        workspace: File.join(ROOT_DIR, "ios/Runner.xcworkspace"),
        scheme: "Runner",
        export_method: export_method,
        export_team_id: team_id,
        output_directory: File.join(ROOT_DIR, "build/ios/ipa"),
        output_name: "naturinorge_guide.ipa",
        clean: true,
        export_options: {
          method: export_method,
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: {
            app_id => profile_name
          }
        }
      }
      xcargs = []
      xcargs << "FLUTTER_BUILD_NAME=#{ENV['BUILD_NAME']}" if ENV['BUILD_NAME']
      xcargs << "FLUTTER_BUILD_NUMBER=#{ENV['BUILD_NUMBER']}" if ENV['BUILD_NUMBER']
      gym_params[:xcargs] = xcargs.join(" ") unless xcargs.empty?

      build_app(gym_params)
    ensure
      UI.message("🧹 Restoring host keychains and deleting ephemeral build keychain...")
      begin
        delete_keychain(name: keychain_name) if File.exist?(keychain_path)
      rescue => e
        UI.important("Ephemeral keychain cleanup notice: #{e.message}")
      end
      sh("security list-keychains -d user -s #{original_keychains.shelljoin}") rescue nil unless original_keychains.empty?
    end

    ipa_path = File.join(ROOT_DIR, "build/ios/ipa/naturinorge_guide.ipa")
    UI.user_error!("IPA was not generated at expected path #{ipa_path}") unless File.exist?(ipa_path)
  end

  desc "Build and distribute iOS beta to TestFlight"
  lane :beta do |options|
    build(options.merge(export_method: "app-store"))

    api_key = setup_asc_api_key
    ipa_path = Dir[File.join(ROOT_DIR, "build/ios/ipa/*.ipa")].first
    UI.user_error!("No IPA found in build/ios/ipa to upload to TestFlight!") unless ipa_path && File.exist?(ipa_path)

    UI.message("🚀 Uploading IPA to TestFlight...")
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and deploy iOS release to App Store Connect / TestFlight"
  lane :release do |options|
    build(options.merge(export_method: "app-store"))

    api_key = setup_asc_api_key
    ipa_path = Dir[File.join(ROOT_DIR, "build/ios/ipa/*.ipa")].first
    UI.user_error!("No IPA found in build/ios/ipa to upload!") unless ipa_path && File.exist?(ipa_path)

    UI.message("🚀 Uploading IPA to TestFlight / App Store Connect...")
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
